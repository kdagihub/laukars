// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── AUTH.JS MODELS ─────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── CORE MODELS ────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  ADMIN
  AGENT
  ASSOCIATE
  CLIENT
}

enum VehicleType {
  SALE
  RENT
}

enum VehicleStatus {
  DRAFT
  PUBLISHED
  SUSPENDED
  UNAVAILABLE
}

enum FuelType {
  GASOLINE
  DIESEL
  ELECTRIC
  HYBRID
  LPG
}

enum TransmissionType {
  MANUAL
  AUTOMATIC
}

enum RequestType {
  BUY
  RENT
}

enum LeadStatus {
  NEW
  CONTACTED
  APPOINTMENT_SET
  VISIT_DONE
  SOLD
  FAILED
  CANCELED
}

enum ProofType {
  RECEIPT
  PHOTO
  DOCUMENT
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  STATUS_CHANGE
  UPLOAD
}

enum AuditEntityType {
  VEHICLE
  LEAD_REQUEST
  USER
  APPOINTMENT
  PROOF
}

// ─── USER ───────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  fullName      String
  phone         String?
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  image         String?
  role          Role      @default(CLIENT)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  accounts      Account[]
  sessions      Session[]
  vehicles      Vehicle[]         @relation("AgentVehicles")
  clientLeads   LeadRequest[]     @relation("ClientLeads")
  agentLeads    LeadRequest[]     @relation("AgentLeads")
  auditLogs     AuditLog[]

  @@index([email])
  @@index([role])
}

// ─── VEHICLE ────────────────────────────────────────────────────────────────

model Vehicle {
  id              String        @id @default(cuid())
  createdByUserId String
  type            VehicleType
  title           String
  brand           String
  model           String
  year            Int
  mileage         Int
  fuel            FuelType
  transmission    TransmissionType
  city            String
  description     String?
  pricePublic     Int
  priceSupplier   Int           // Hidden from clients
  status          VehicleStatus @default(DRAFT)
  fingerprint     String?       // Anti-duplicate: brand+model+year+mileage+supplierPhone
  viewCount       Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  createdBy       User          @relation("AgentVehicles", fields: [createdByUserId], references: [id])
  photos          VehiclePhoto[]
  rentalPolicy    RentalPolicy?
  leadRequests    LeadRequest[]

  @@index([status])
  @@index([type])
  @@index([brand])
  @@index([city])
  @@index([fingerprint])
}

// ─── VEHICLE PHOTO ──────────────────────────────────────────────────────────

model VehiclePhoto {
  id        String   @id @default(cuid())
  vehicleId String
  url       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
}

// ─── RENTAL POLICY ──────────────────────────────────────────────────────────

model RentalPolicy {
  id              String  @id @default(cuid())
  vehicleId       String  @unique
  pricePerDay     Int?
  pricePerWeek    Int?
  pricePerMonth   Int?
  deposit         Int?    // Caution
  kmIncluded      Int?    // Kilometres included per day
  conditions      String? // Return conditions, rules, etc.

  vehicle         Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
}

// ─── LEAD REQUEST (DEMANDE) ─────────────────────────────────────────────────

model LeadRequest {
  id            String      @id @default(cuid())
  vehicleId     String
  clientUserId  String?     // Nullable if guest
  agentId       String?     // Assigned agent (multi-agent support)
  clientName    String
  clientPhone   String
  clientCity    String
  message       String?
  requestType   RequestType
  status        LeadStatus  @default(NEW)
  codeA         String      @unique // Visit code - generated at creation
  codeB         String?     @unique // Closure code - generated after appointment
  failureReason String?     // Required when status = FAILED
  surveyAnswer  String?     // Client survey response: "YES" | "NO" | null
  margin        Int?        // Computed: pricePublic - priceSupplier
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  contactedAt   DateTime?
  appointmentAt DateTime?
  closedAt      DateTime?

  // Relations
  vehicle       Vehicle     @relation(fields: [vehicleId], references: [id])
  client        User?       @relation("ClientLeads", fields: [clientUserId], references: [id])
  agent         User?       @relation("AgentLeads", fields: [agentId], references: [id])
  appointment   Appointment?
  proofs        Proof[]

  @@index([vehicleId])
  @@index([agentId])
  @@index([status])
  @@index([codeA])
}

// ─── APPOINTMENT (RDV) ──────────────────────────────────────────────────────

model Appointment {
  id            String      @id @default(cuid())
  leadRequestId String      @unique
  scheduledAt   DateTime
  locationText  String
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  leadRequest   LeadRequest @relation(fields: [leadRequestId], references: [id], onDelete: Cascade)
}

// ─── PROOF (PREUVE DE VENTE) ────────────────────────────────────────────────

model Proof {
  id            String    @id @default(cuid())
  leadRequestId String
  fileUrl       String
  proofType     ProofType
  createdAt     DateTime  @default(now())

  leadRequest   LeadRequest @relation(fields: [leadRequestId], references: [id], onDelete: Cascade)

  @@index([leadRequestId])
}

// ─── AUDIT LOG ──────────────────────────────────────────────────────────────

model AuditLog {
  id          String          @id @default(cuid())
  actorUserId String
  entityType  AuditEntityType
  entityId    String
  action      AuditAction
  metaJson    String?         // JSON string with before/after data
  createdAt   DateTime        @default(now())

  actor       User            @relation(fields: [actorUserId], references: [id])

  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([createdAt])
}
